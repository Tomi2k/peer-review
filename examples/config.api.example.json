{
  "schema_version": "1.0",
  "state_dir": "~/.local/state/peer-review",
  "language": "en",
  "selection": {
    "k_cost_doubling": 5.0,
    "quality_buffer": 3.0,
    "min_context_window": 128000,
    "required_capabilities": ["coding", "reasoning"],
    "allow_routers": false
  },
  "source": {
    "url": "https://artificialanalysis.ai/agents/coding-agents",
    "firecrawl_mode": "api",
    "firecrawl_api_url": "https://api.firecrawl.dev/v2/scrape",
    "firecrawl_api_key_env": "FIRECRAWL_API_KEY",
    "timeout_seconds": 90
  },
  "schedule": {
    "timezone": "UTC",
    "daily_hour": 6,
    "daily_minute": 15
  },
  "notifications": {
    "language": "en",
    "local_log": true,
    "webhook_url_env": "PEER_REVIEW_WEBHOOK_URL",
    "webhook_format": "slack"
  },
  "review": {
    "timeout_seconds": 600,
    "max_clarification_rounds": 1,
    "read_only": true
  },
  "moderator": {
    "mode": "provider",
    "provider": "anthropic",
    "backend": "api",
    "model_id": "claude-fable-5-2",
    "effort": "high"
  },
  "providers": {
    "anthropic": {
      "api_style": "anthropic",
      "api_key_env": "ANTHROPIC_API_KEY",
      "max_tokens": 8192
    },
    "openai": {
      "api_style": "openai",
      "api_key_env": "OPENAI_API_KEY"
    },
    "google": {
      "api_style": "google",
      "api_key_env": "GEMINI_API_KEY"
    },
    "xai": {
      "api_style": "xai",
      "api_key_env": "XAI_API_KEY"
    }
  },
  "catalog": [
    {
      "creator_slug": "google",
      "agent_slug": "antigravity-cli",
      "match_model_release": "Gemini 4 Neon",
      "efforts": ["low", "medium", "high", "xhigh"],
      "provider": "google",
      "backend": "api",
      "model_id": "gemini-4-neon",
      "context_window": 1000000,
      "capabilities": ["coding", "reasoning"]
    },
    {
      "creator_slug": "google",
      "agent_slug": "antigravity-cli",
      "match_model_release": "Gemini 4 Carbon",
      "efforts": ["low", "medium", "high"],
      "provider": "google",
      "backend": "api",
      "model_id": "gemini-4-carbon",
      "context_window": 1000000,
      "capabilities": ["coding", "reasoning"]
    },
    {
      "creator_slug": "anthropic",
      "agent_slug": "claude-code",
      "match_model_release": "Claude Fable 5.2",
      "efforts": ["low", "medium", "high", "xhigh", "max"],
      "provider": "anthropic",
      "backend": "api",
      "model_id": "claude-fable-5-2",
      "context_window": 200000,
      "capabilities": ["coding", "reasoning"]
    },
    {
      "creator_slug": "anthropic",
