<?xml version="1.0" encoding="UTF-8"?>
<!-- Review Artificial Analysis and provider Terms of Service before enabling unattended runs (see README). -->
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>Label</key>
  <string>com.peer-review.updater</string>
  <key>Umask</key>
  <integer>63</integer>
  <key>ProgramArguments</key>
  <array>
    <string>/Users/YOU/.local/bin/peer-review-update</string>
  </array>
  <key>EnvironmentVariables</key>
  <dict>
    <key>TZ</key>
    <string>UTC</string>
    <key>PATH</key>
    <string>/Users/YOU/.local/bin:/opt/homebrew/bin:/usr/local/bin:/usr/bin:/bin</string>
  </dict>
  <key>StartCalendarInterval</key>
  <dict>
    <key>Hour</key>
    <integer>6</integer>
    <key>Minute</key>
    <integer>15</integer>
  </dict>
  <key>StandardOutPath</key>
  <string>/Users/YOU/.local/state/peer-review/updater.stdout.log</string>
  <key>StandardErrorPath</key>
  <string>/Users/YOU/.local/state/peer-review/updater.stderr.log</string>
</dict>
</plist>
